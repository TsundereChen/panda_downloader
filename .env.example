# Obtain this from @BotFather. Never commit your real token.
TELEGRAM_BOT_TOKEN=

# A comma-separated allow-list of numeric Telegram user IDs. Leave empty only
# while first running /whoami to learn your ID.
ALLOWED_TELEGRAM_USER_IDS=

# A password users must enter with /login before download commands are enabled.
BOT_ACCESS_PASSWORD=change-this-long-random-password

# Generate this with `python eh_web_login.py --write-env .env` after manually
# completing verification and visiting both E-Hentai and ExHentai in its desktop
# window. It contains ipb_member_id, ipb_pass_hash, and (for ExHentai) igneous.
EH_COOKIE=

# Destination for finished archive files. Must be writable by this process.
DOWNLOAD_DIR=./downloads

# Archive format requested from the site: org (original files) or res
# (resampled files). Original files may cost more archive points.
ARCHIVE_TYPE=org

# A hard safety limit per completed download, in GiB.
MAX_ARCHIVE_GIB=8

# The bot will wait this long for server-side archive preparation.
ARCHIVE_WAIT_MINUTES=30

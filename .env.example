# Obtain this from @BotFather. Never commit your real token.
TELEGRAM_BOT_TOKEN=

# Required comma-separated allow-list of positive numeric Telegram user IDs.
# The bot will refuse to start when this is empty. Use Telegram's account UI or
# a trusted ID-information bot to learn your ID before starting this bot.
ALLOWED_TELEGRAM_USER_IDS=

# Generate this with `python panda_web_login.py --write-env .env` after manually
# completing verification and visiting both E-Hentai and ExHentai in its desktop
# window. It contains ipb_member_id, ipb_pass_hash, and (for ExHentai) igneous.
# Keep this value unquoted for compatibility with Podman --env-file.
EH_COOKIE=

# Destination for finished archive files. Must be writable by this process.
DOWNLOAD_DIR=./downloads

# Archive format requested from the site: org (original files) or res
# (resampled files). Original files may cost more archive points.
ARCHIVE_TYPE=org

# A hard safety limit per completed download, in GiB.
MAX_ARCHIVE_GIB=8

# Maximum combined size of completed files in DOWNLOAD_DIR, in GiB.
MAX_TOTAL_DOWNLOAD_GIB=64

# Space that must remain free on the destination filesystem, in GiB.
MIN_FREE_DISK_GIB=1

# The bot will wait this long for server-side archive preparation.
ARCHIVE_WAIT_MINUTES=30

# Maximum number of waiting jobs. One archive is downloaded at a time.
JOB_QUEUE_SIZE=20

# Optional additional trusted archive-download domains, comma-separated. The
# two gallery domains plus the official hath.network archive CDN and their
# subdomains are always trusted. Add a host only if the archive page currently
# returns downloads from another domain.
ARCHIVE_DOWNLOAD_HOSTS=

# Log every call and return for functions defined in bot.py. Function arguments
# and return values are never logged. Set to false if the volume is excessive;
# archive workflow and HTTP state-transition logs remain enabled either way.
FUNCTION_TRACE_LOGGING=true
